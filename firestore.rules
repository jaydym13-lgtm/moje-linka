rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // 1. ZÁKLADNÍ FUNKCE 
    // ==========================================================
    function isAuth() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuth() && get(/databases/$(database)/documents/linka_data/nastaveni).data.get('owner_users', {}).get(request.auth.uid, false) == true;
    }

    function isNotFrozen() {
      return isOwner() || (
        isAuth() && 
        (!('isFrozen' in request.auth.token) || request.auth.token.isFrozen != true) &&
        get(/databases/$(database)/documents/linka_data/nastaveni).data.get('zmrazeni', {}).get(request.auth.uid, false) != true
      );
    }

    function isAdmin() {
      return isNotFrozen() && (isOwner() || ('role' in request.auth.token && request.auth.token.role == 'Admin'));
    }

    function isEditor() {
      return isNotFrozen() && (isAdmin() || ('role' in request.auth.token && request.auth.token.role == 'Editor'));
    }

    // ==========================================================
    // 2. HLAVNÍ KOLEKCE: LINKA_DATA (PŘÍSNÁ DOKUMENTOVÁ IZOLACE)
    // ==========================================================
    match /linka_data/nastaveni {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /linka_data/databaze_master {
      allow read: if isAuth();
      allow update: if isEditor() && 
        request.resource.data.keys().hasAll(['vyroba', 'baleni']) &&
        request.resource.data.vyroba is map &&
        request.resource.data.baleni is map;
      allow create: if isAdmin();
      allow delete: if false; // Zákaz úplného smazání databáze receptur
    }

    match /linka_data/hlaseni {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /linka_data/zamek {
      allow read: if isAuth();
      allow create: if isEditor();
      allow update, delete: if isEditor() && (
        isAdmin() || 
        resource.data.kdo == request.auth.uid || 
        (request.time.toMillis() - resource.data.cas > 300000)
      );
    }

    match /linka_data/uzivatele {
      allow read: if isAdmin(); // Běžný uživatel nesmí vidět profily a zařízení ostatních
      allow update: if isAuth() && isNotFrozen() && (
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
      );
      allow create: if isAuth() && isNotFrozen() && (
        isAdmin() || request.resource.data.keys().hasOnly([request.auth.uid])
      );
      allow delete: if isAdmin();
    }

    // ==========================================================
    // 3. KOLEKCE: UZIVATELE ONLINE (OCHRANA SOUKROMÍ)
    // ==========================================================
    match /uzivatele_online/{userId} {
      allow read: if isAuth() && (isAdmin() || request.auth.uid == userId);
      
      allow create, update: if isAuth() && isNotFrozen() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['deviceId']) &&
          request.resource.data.deviceId is string &&
          request.resource.data.deviceId.size() < 50
        )
      );
      
      allow delete: if isAuth() && (isAdmin() || request.auth.uid == userId);
    }

    // ==========================================================
    // 4. KOLEKCE: SECURITY LOGS 
    // ==========================================================
    match /security_logs/{logId} {
      allow read, delete: if isAdmin();
      allow create, update: if false; // Zápis provádí výhradně server přes Cloud Function
    }
  }
}